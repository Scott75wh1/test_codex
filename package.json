{
  "name": "soundtouch-radio-remote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend locale Node.js/Express per controllare Bose SoundTouch e servire il frontend React/Vite buildato.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/clean.js && node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "start": "node server/index.js",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "multer": "^2.0.2",
    "adm-zip": "^0.5.16"
  }
}
